# ---------------------------------------------------------------------------
# Listora — copy this file to .env.local and fill in the values.
# .env.local is gitignored; never commit real keys.
# ---------------------------------------------------------------------------

# Neon Postgres. Use the POOLED connection string from the Neon dashboard
# (the host contains "-pooler"). Must include ?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Auth ------------------------------------------------------------------
# While true, the app resolves every request to DEV_AGENT_ID instead of a real
# session. Flip to false once NextAuth is wired up.
SKIP_AUTH="true"
# Printed by `npm run db:seed`
DEV_AGENT_ID=""

# --- AI --------------------------------------------------------------------
# "groq" | "claude"
AI_PROVIDER="groq"

# GroqCloud (open-weight models: Llama, gpt-oss, Qwen). NOT xAI's Grok —
# different company. Groq keys start with gsk_, xAI keys with xai-.
# Key from https://console.groq.com
GROQ_API_KEY=""
# `GET https://api.groq.com/openai/v1/models` lists what your key can reach.
GROQ_MODEL="llama-3.3-70b-versatile"
# GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Anthropic (for the quality comparison later — not needed while AI_PROVIDER=groq)
# ANTHROPIC_API_KEY=""

# --- Image storage (step 4) ------------------------------------------------
# Auto-populated by the Vercel Blob integration when deployed.
BLOB_READ_WRITE_TOKEN=""

# --- Stripe (step 8) -------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""

# --- App -------------------------------------------------------------------
# Used to build absolute shareable listing URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
